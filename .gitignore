# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!apps/web/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Archivos de Claude Code
.claude/
CLAUDE.md

# Configuración local de Codex y skill del proyecto
/.codex
/.agents/skills/

#Store

.pnpm-store

# Respaldos locales de BD: contienen datos y nunca se versionan.
.backups/

# Evidencias de pruebas E2E (Selenium)
apps/web/tests/e2e/evidencias/
**/evidencias/*.png

# Imágenes procesadas en disco; conservar solo el marcador de la carpeta.
apps/web/uploads/*
!apps/web/uploads/.gitkeep

# Documentación interna: se conserva localmente, no se publica.
/docs/
/Biodentis-sprint-Hus.md

# Credenciales locales de AWS.
/.aws/
