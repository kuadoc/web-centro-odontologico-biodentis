# Almacenamiento de imágenes (fases 1 y 2).
# local: apps/web/uploads/; requiere disco persistente y permiso de escritura.
# s3: reservado para una implementación futura compatible con S3/Cloudflare R2.
# Seleccionar s3 actualmente devuelve un error explícito; no utiliza disco como fallback.
STORAGE_DRIVER=local

# Mantener las demás variables existentes en .env; no reemplazarlo por este archivo.

# Solo desarrollo: el seed exige al menos 12 caracteres y no actualiza claves existentes.
# Define los valores reales únicamente en .env o en el entorno de tu terminal.
SEED_DEMO_PASSWORD=

# E2E: E2E_PASSWORD o contraseñas separadas por rol. Sin valores predeterminados.
# El runner no carga .env automáticamente; exporta estas variables antes de ejecutarlo.
E2E_PASSWORD=
E2E_PATIENT_EMAIL=paciente@biodentis.com
E2E_RECEPTION_EMAIL=recepcion@biodentis.com
E2E_DENTIST_EMAIL=dr.martinez@biodentis.com
E2E_PATIENT_NAME="Ana López"
E2E_DENTIST_NAME=Martínez
E2E_PATIENT_PASSWORD=
E2E_RECEPTION_PASSWORD=
E2E_DENTIST_PASSWORD=
