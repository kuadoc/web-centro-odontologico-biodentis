 
# PostgreSQL local: sustituir usuario y contraseña por los de tu instalación.
DATABASE_URL="postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:CAMBIAR_PASSWORD@localhost:5432/postgres?schema=public"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:3000
# Necesario para autorizar el trabajador /api/cron/email-outbox.
CRON_SECRET=

STORAGE_DRIVER=local
# En Vercel usar s3. El bucket debe ser privado; las fotos se sirven por la API.
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=biodentis.drive
S3_IMAGE_PREFIX=imagen
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Gmail SMTP: contraseña de aplicación con verificación en dos pasos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cuenta@gmail.com
SMTP_PASSWORD=
EMAIL_MODE=test
EMAIL_FROM="Clínica BIODENTIS <cuenta@gmail.com>"
EMAIL_TEST_RECIPIENT=
 
# Mínimo 12 caracteres, máximo 72 bytes. Restaura las contraseñas demo al repetir.
# Ejemplo exclusivo para tu BD local: BiodentisLocal2026!
SEED_DEMO_PASSWORD=
 
E2E_PASSWORD=
E2E_PATIENT_EMAIL=paciente@biodentis.com
E2E_RECEPTION_EMAIL=recepcion@biodentis.com
E2E_DENTIST_EMAIL=dr.martinez@biodentis.com
E2E_PATIENT_NAME="Ana López"
E2E_DENTIST_NAME=Martínez
E2E_PATIENT_PASSWORD=
E2E_RECEPTION_PASSWORD=
E2E_DENTIST_PASSWORD=
