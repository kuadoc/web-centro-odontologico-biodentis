generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  RECEPTIONIST
  DENTIST
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum DentalUnitType {
  SILLON
  QUIRURGICO
  RADIOLOGICO
}

enum DentalUnitStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum ExceptionScope {
  DENTIST
  CLINIC
  UNIT
}

enum ExceptionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SettingType {
  NUMBER
  STRING
  BOOLEAN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dentistProfile  Dentist?
  clinicalRecords ClinicalRecord[] @relation("PatientRecords")
  appointments    Appointment[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model Dentist {
  id        String @id @default(uuid())
  userId    String @unique
  specialty String

  user               User                 @relation(fields: [userId], references: [id])
  availability       Availability[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]
  clinicalRecords    ClinicalRecord[]     @relation("DentistRecords")

  @@map("dentists")
}

model Availability {
  id        String @id @default(uuid())
  dentistId String
  dayOfWeek Int
  startTime String
  endTime   String

  dentist Dentist @relation(fields: [dentistId], references: [id])

  @@unique([dentistId, dayOfWeek])
  @@map("availability")
}

model ScheduleException {
  id        String           @id @default(uuid())
  dentistId String
  startDate DateTime
  endDate   DateTime
  reason    String?
  scope     ExceptionScope   @default(DENTIST)
  status    ExceptionStatus  @default(PENDING)

  dentist Dentist @relation(fields: [dentistId], references: [id])

  @@unique([dentistId, startDate])
  @@map("schedule_exceptions")
}

model Appointment {
  id        String            @id @default(uuid())
  patientId String
  dentistId String
  date      DateTime          @db.Date
  startTime String
  endTime   String
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  patient        User             @relation(fields: [patientId], references: [id])
  dentist        Dentist          @relation(fields: [dentistId], references: [id])
  clinicalRecord ClinicalRecord?

  @@unique([dentistId, date, startTime])
  @@map("appointments")
}

model ClinicalRecord {
  id            String   @id @default(uuid())
  patientId     String
  dentistId     String
  appointmentId String   @unique
  notes         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient     User        @relation("PatientRecords", fields: [patientId], references: [id])
  dentist     Dentist     @relation("DentistRecords", fields: [dentistId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("clinical_records")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  resourceType String
  resourceId   String
  details      String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Clinic {
  id           String  @id @default(uuid())
  name         String
  address      String?
  phone        String?
  generalHours String?
  email        String?
  rut          String?
  website      String?
  logoUrl      String?

  @@map("clinic")
}

model DentalUnit {
  id          String           @id @default(uuid())
  name        String
  type        DentalUnitType
  status      DentalUnitStatus @default(ACTIVE)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("dental_units")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  subject   String
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model SystemSetting {
  id    String     @id @default(uuid())
  key   String     @unique
  value String
  type  SettingType @default(NUMBER)

  @@map("system_settings")
}

model RefreshToken {
  id               String    @id @default(uuid())
  jti              String    @unique
  tokenHash        String    @unique
  userId           String
  deviceInfo       String?
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedByToken  String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
