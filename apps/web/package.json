{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "npx prisma generate",
    "db:catalog": "prisma db execute --file prisma/catalog-upgrade.sql --schema prisma/schema.prisma",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "test:e2e": "mocha --import tsx --extension ts tests/e2e/appointment-happy-path.spec.ts",
    "test:storage": "node --require tsx/cjs --test tests/storage/storage.service.test.cts tests/storage/uploads.route.test.cts",
    "test:appointments": "node --require tsx/cjs --test tests/unit/appointment-concurrency.test.cts tests/integration/clinical-note-permissions.test.cts",
    "storage:probar": "node --env-file=.env --require tsx/cjs scripts/probar-storage.cts"
  },
  "dependencies": {
    "@biodentis/shared-types": "workspace:*",
    "@biodentis/shared-validators": "workspace:*",
    "@prisma/client": "^6.12.0",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-query": "^5.102.8",
    "@workspace/ui": "workspace:*",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.37.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "prisma": "6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.28.0",
    "sharp": "0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/selenium-webdriver": "^4.1.27",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "mocha": "^11.0.0",
    "selenium-webdriver": "^4.27.0",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
