{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "npx prisma generate",
    "db:catalog": "prisma db execute --file prisma/catalog-upgrade.sql --schema prisma/schema.prisma",
    "db:patient-dni": "prisma db execute --file prisma/patient-dni-upgrade.sql --schema prisma/schema.prisma",
    "db:appointment-cancellations": "prisma db execute --file prisma/appointment-cancellation-upgrade.sql --schema prisma/schema.prisma",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "test:e2e": "mocha --import tsx --extension ts tests/e2e/appointment-happy-path.spec.ts",
    "test:auth": "node --require tsx/cjs --test tests/auth/login.test.cts",
    "test:auth-service": "node --require tsx/cjs --test tests/auth/auth.service.test.cts tests/unit/registration-form.test.cts",
    "test:route-access": "node --require tsx/cjs --test tests/auth/route-access.test.cts",
    "test:dates": "node --require tsx/cjs --test tests/unit/date-display.test.cts",
    "test:report-export": "node --require tsx/cjs --test tests/unit/appointment-report-export.test.cts",
    "test:reports": "node --require tsx/cjs --test tests/unit/appointment-analytics.test.cts tests/unit/appointment-reminders.test.cts tests/unit/appointment-report-export.test.cts tests/auth/route-access.test.cts tests/integration/appointment-analytics-permissions.test.cts",
    "test:email": "node --require tsx/cjs --test tests/unit/email-policy.test.cts tests/unit/smtp-email.test.cts tests/unit/appointment-notification.test.cts tests/unit/business-integrity.test.cts",
    "test:seed": "node --require tsx/cjs --test tests/unit/seed-local.test.cts",
    "test:integrity-local": "node --require tsx/cjs --test tests/integration/integrity-local-database.cts",
    "test:acid-local": "node --env-file=.env scripts/local-database-maintenance.cjs test tests/integration/acid-corrections.cts",
    "test:patient-dni": "node --require tsx/cjs --test tests/unit/patient-dni.test.cts",
    "test:appointment-filters": "node --require tsx/cjs --test tests/unit/appointment-filters.test.cts",
    "test:session": "node --require tsx/cjs --test tests/auth/client-session.test.cts tests/auth/access-session.test.cts",
    "test:availability": "node --require tsx/cjs --test tests/availability/availability.service.test.cts tests/availability/schedule-changes.test.cts tests/availability/exceptions.test.cts tests/integration/availability-permissions.test.cts tests/integration/exception-permissions.test.cts",
    "test:storage": "node --require tsx/cjs --test tests/storage/storage.service.test.cts tests/storage/uploads.route.test.cts tests/storage/s3.driver.test.cts",
    "test:appointments": "node --require tsx/cjs --test tests/unit/appointment-create.test.cts tests/unit/appointment-concurrency.test.cts tests/unit/appointment-notes.test.cts tests/unit/appointment-notification.test.cts tests/unit/reception-booking-transaction.test.cts tests/integration/reception-booking.test.cts tests/integration/clinical-note-permissions.test.cts",
    "test:reassignments": "node --require tsx/cjs --test tests/unit/dentist-reassignment.test.cts tests/integration/reassignment-permissions.test.cts tests/unit/appointment-concurrency.test.cts",
    "test:cancellations": "node --require tsx/cjs --test tests/unit/appointment-cancellation.test.cts tests/unit/appointment-reschedule-permissions.test.cts tests/integration/cancellation-permissions.test.cts",
    "storage:probar": "node --env-file=.env --require tsx/cjs scripts/probar-storage.cts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@biodentis/shared-types": "workspace:*",
    "@biodentis/shared-validators": "workspace:*",
    "@prisma/client": "^6.12.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "2.0.6",
    "@tanstack/react-query": "^5.102.8",
    "@workspace/ui": "workspace:*",
    "bcrypt": "^5.1.1",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.37.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.0",
    "prisma": "6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.11.0",
    "sharp": "0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/selenium-webdriver": "^4.1.27",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "mocha": "^11.0.0",
    "selenium-webdriver": "^4.27.0",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
